# Шаблон конфигурации sheremetevo-app.
# Скопируйте в configs/app.ini и подставьте свои адреса; app.ini в git не хранится.
# Относительные пути считаются от папки, где лежит этот файл.

[app]
# конфиг детектора; пути внутри него nvinfer считает от его собственной папки
nvinfer-config=config_infer_primary_yolo.txt
# размер кадров в пачке nvstreammux (и выхода nvdewarper)
frame-width=1728
frame-height=2752
# сколько nvstreammux ждёт отставшую камеру, прежде чем отправить пачку без неё
batched-push-timeout-us=40000
# класс детектора, который считается самолётом (4 — airplane в COCO); -1 — любой
class-id=4

[rtsp]
# камера без кадров дольше stall-timeout-sec (или с ошибкой) перезапускается;
# пауза между попытками подключения — reconnect-interval-sec
stall-timeout-sec=10
reconnect-interval-sec=5

[health]
# heartbeat-файл раз в 2 с: время, возраст последнего кадра, сколько камер шлют
# кадры; по нему Docker HEALTHCHECK решает, здоров ли контейнер. Пустое — не писать
heartbeat-file=/tmp/sheremetevo-health
# главный цикл не отвечает дольше — аварийный выход (Docker перезапустит); 0 — не следить
hang-timeout-sec=60
# ни одного обработанного кадра ни с одной камеры дольше — штатная остановка
# с кодом 1 для перезапуска; 0 — не перезапускать
no-frames-restart-sec=300

[logging]
# Журнал приложения; группа необязательна. Строка журнала: время, уровень,
# компонент, камера. debug и info идут в stdout, warning и error — в stderr.
# уровень: debug, info, warning, error
level=info
# text — для чтения глазами, json — по записи на строку для Loki/ELK/jq
format=text
# файл журнала в дополнение к stdout/stderr, папка должна существовать;
# не задан или пустой — не писать (в Docker логи и так собирает Docker)
#file=/var/log/sheremetevo/app.log
# ротация: при превышении размера app.log -> app.log.1 -> ... -> app.log.<max-files>;
# max-size-mb=0 — без ротации
max-size-mb=50
max-files=5

[metrics]
# Метрики Prometheus на http://<bind-address>:<port>/metrics (fps, задержка,
# статус и перезапуски камер, отправка UDP); группа необязательна.
# false или нет группы — порт не открывается
enabled=false
# 127.0.0.1 — доступны только с этой машины
bind-address=0.0.0.0
port=9464

[output]
# видео с разметкой: <uri-prefix>_<номер камеры>; false — без видеовыхода (быстрее)
enabled=true
uri-prefix=rtsp://<output-host>:8554/output

[udp]
# получатель точек; формат датаграмм — proto/points.proto
host=<receiver-host>
port=6767
# точки копятся batch-interval-ms и уходят пачкой; 0 — каждый кадр сразу
batch-interval-ms=1000
# предел размера датаграммы, байт: 1400 проходит без IP-фрагментации,
# больше (до 65507) — меньше датаграмм, но потеря фрагмента губит всю датаграмму
max-datagram-bytes=1400

[geo]
# порог RANSAC при расчёте гомографии, в метрах
ransac-threshold-m=10
# минимальное отношение ширины bbox к высоте
min-aspect-ratio=1.2
# CSV с вершинами зоны (lng,lat), в которой ожидаются объекты; точки вне
# зоны не отправляются. Общая для всех камер, у камеры можно задать свою
# в [cameraN] zone=. Без параметра фильтра по зоне нет.
# Шаблон: configs/zone.csv.example
#zone=zone.csv

[tracker]
# true — добавить nvtracker: у объектов появится постоянный object_id;
# false или нет секции — трекера нет, object_id = -1
enabled=true
ll-lib-file=/opt/nvidia/deepstream/deepstream/lib/libnvds_nvmultiobjecttracker.so
# готовые конфиги из DeepStream: config_tracker_IOU.yml (самый быстрый),
# config_tracker_NvSORT.yml, config_tracker_NvDCF_perf.yml (устойчив к перекрытиям)
ll-config-file=/opt/nvidia/deepstream/deepstream/samples/configs/deepstream-app/config_tracker_NvDCF_perf.yml
# размер кадра для трекера, кратно 32
width=960
height=544

# Камеры: номер группы — camera_id в UDP-сообщениях, номера подряд с 0.
#   uri             — адрес RTSP-потока (обязательно)
#   calibration     — CSV с точками pixel_x,pixel_y,lng,lat (обязательно)
#   flip-method     — поворот nvvideoconvert, 0..7 (1 — на 90° против часовой);
#                     не задан — поворота нет
#   dewarper-config — конфиг nvdewarper; не задан — кадр не выпрямляется
# Модули преобразования добавляются в конвейер, только если их параметры заданы.
[camera0]
uri=rtsp://<camera-host>:8554/camera0
flip-method=1
dewarper-config=warper.toml
calibration=calibration/camera0.csv
# своя зона камеры вместо [geo] zone; пустое значение — без фильтра по зоне
#zone=zones/camera0.csv

[camera1]
uri=rtsp://<camera-host>:8554/camera1
flip-method=1
dewarper-config=warper.toml
calibration=calibration/camera1.csv

[camera2]
uri=rtsp://<camera-host>:8554/camera2
flip-method=1
dewarper-config=warper.toml
calibration=calibration/camera2.csv

[camera3]
uri=rtsp://<camera-host>:8554/camera3
flip-method=1
dewarper-config=warper.toml
calibration=calibration/camera3.csv
